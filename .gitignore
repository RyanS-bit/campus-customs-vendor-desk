# Secrets and private environment files (never commit)
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
secrets*.json

# Python caches and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Local virtual environments
.venv/
venv/
env/

# Temporary files (e.g. interrupted atomic JSON writes)
*.tmp
*.json.tmp

# Editor, agent and OS machine-specific files
.vscode/
.idea/
.claude/
.mcp.json
Thumbs.db
desktop.ini
.DS_Store
